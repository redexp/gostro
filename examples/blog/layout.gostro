// A layout is an ordinary component with slots.
type LayoutProps struct {
	Title string
}

path := ctx.Request().URL.Path

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{props.Title}{" · gostro blog"}</title>
    {ctx.Styles()}
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href="/">{"gostro"}</a>
      <nav>
        for _, link := range []struct{ Href, Label string }{{"/", "Posts"}, {"/about", "About"}} {
          <a href={link.Href} class:list={[]any{"nav-link", map[string]bool{"active": path == link.Href}}}>{link.Label}</a>
        }
      </nav>
    </header>
    <main>
      <slot name="hero"/>
      <slot/>
    </main>
    <footer><slot name="footer">{"Made with gostro"}</slot></footer>
    {ctx.Scripts()}
    {__gostro.LiveReload()}
  </body>
</html>

<style>
  :root { --accent: #0b6bcb; --muted: #667; }
  * { box-sizing: border-box; }
  body { margin: 0; font: 16px/1.6 system-ui, sans-serif; color: #222; }
  main { max-width: 760px; margin: 0 auto; padding: 24px 16px; }
  .site-header { display: flex; gap: 24px; align-items: center; padding: 12px 16px; border-bottom: 1px solid #eee; }
  .logo { font-weight: 700; color: var(--accent); text-decoration: none; }
  .nav-link { color: var(--muted); text-decoration: none; margin-right: 12px; }
  .nav-link.active { color: #222; font-weight: 600; }
  footer { text-align: center; color: var(--muted); padding: 24px; }
</style>
