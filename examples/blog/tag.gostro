import "net/url"

type TagProps struct {
	Name   string
	Active bool
}

href := "/?tag=" + url.QueryEscape(props.Name)
if props.Active {
	href = "/"
}

<a href={href} class:list={[]any{"tag", map[string]bool{"tag--active": props.Active}}}>{"#"}{props.Name}</a>

<style>
  .tag { display: inline-block; padding: 0 8px; margin: 0 4px 4px 0; border-radius: 12px; background: #eef4fb; color: var(--accent); text-decoration: none; font-size: 14px; }
  .tag--active { background: var(--accent); color: #fff; }
</style>
