type LayoutProps struct {
	Title string
}

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <title>{props.Title}</title>
    {ctx.Styles()}
  </head>
  <body>
    <header><slot name="header">{"Default header"}</slot></header>
    <main><slot/></main>
    {ctx.Scripts()}
  </body>
</html>

<style>
  body { font-family: sans-serif; }
</style>
